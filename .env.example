# Copy to .env.local for local development (`vercel dev`), and add the same
# values in Vercel → Project → Settings → Environment Variables for production.

# ── Admin panel (/admin) ─────────────────────────────────────────────
# Password for the reel admin. Use something long. Changing it signs everyone out.
ADMIN_PASSWORD=

# ── Cloudinary (reel storage + automatic video compression) ─────────
# From cloudinary.com → Settings → API Keys (or the dashboard home).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: where uploads go and how reels are tagged.
# CLOUDINARY_FOLDER=zoomify/reels
# CLOUDINARY_TAG=zoomify-reel

# ── Contact form (EmailJS) ──────────────────────────────────────────
# These are public (VITE_ prefix = included in the browser bundle).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
